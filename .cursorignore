# Cursor AI indexing ignore — large dirs/files on this workspace (~174G home).
# Patterns follow .gitignore-style globs. Does NOT hide files in the Explorer;
# use .vscode/settings.json files.exclude for that.

# --- Measured large directories (2026-07-29) ---
archive/
miniconda3/
anaconda3/
data/
# runs/ — fully visible (logs, figures, checkpoints)
raw/
ready_legnet/
ready_caduceus/
ready/
ready_*/
data_ready/
data_ready_*/
legnet_ready/
legnet_ready_*/
software/
mag/
# Root scratch only (keep src/run/ indexable)
/run/
/run0/
prokaryotes/
genomes_smoketest/
random/
/figures/
/logs/
clean/
bin/

# Materialized split folds (keep splits/*.md strategy docs indexed)
splits/*/
splits.tar.gz

# Architecture / panel materializations
MARKED/
PARSED/
PREDICT/
SPLIT/
data_splits/
ready_splits/
splits_small/

# --- Tooling / caches / IDE state ---
.cursor-server/
.vscode-server/
.vscode/
.cache/
.config/
.codex/
.conda/
.anaconda/
.local/
