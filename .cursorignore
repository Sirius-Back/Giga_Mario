# --- Keep tiny pytest fixtures / code visible to the agent ---
!tests/fixtures/ready_v2_mock/
!tests/fixtures/ready_v2_mock/**
!tests/fixtures/mini_raw/**/*.fna
!tests/fixtures/mini_raw/**/*.gtf
!tests/fixtures/mini_raw/**/*.fai
!tests/fixtures/mini_raw/**/*.fa
!tests/**/*.py
!configs/**
!src/**
!wiki/**
!docs/**/*.md
!splits/*.md

# --- Exceptions: small fixtures / docs the agent should still see ---
!tests/**/*.csv
!tests/**/*.tsv
!.cursor/skills/**/*.csv
!.cursor/skills/**/*.tsv
!.cursor/skills/**/*.md
!.cursor/rules/**

# Allow all content under runs/ despite broad globs (*.ckpt, *.csv, figures/, …)
!runs/
!runs/**
/runs_aligned/
/runs_unif/
